# Android specific gitignore

# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder
proguard/

# Log Files
*.log

# Android Studio
.navigation/
captures/
*.iml
.idea/
*.ipr
*.iws

# Keystore files
*.jks
*.keystore

# External native build folder
.externalNativeBuild
.cxx/

# Google Services
google-services.json

# Android Profiling
*.hprof

# Signing files
release/

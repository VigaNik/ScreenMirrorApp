# Auto detect text files and perform LF normalization
* text=auto

# Swift
*.swift text diff=swift

# Kotlin
*.kt text diff=kotlin
*.kts text diff=kotlin

# Android
*.xml text
*.gradle text
*.properties text
*.pro text

# Documentation
*.md text
*.txt text

# Scripts
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.flv binary
*.fla binary
*.swf binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary
*.apk binary
*.ipa binary
*.dSYM binary
